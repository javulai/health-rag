# Local development only. Copy to .env; never commit real credentials.
POSTGRES_DB=thesis
POSTGRES_USER=thesis
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=55432
API_PORT=8000
# Used when running Python on the host (Compose replaces the hostname internally).
DATABASE_URL=postgresql+psycopg://thesis:CHANGE_ME@localhost:55432/thesis
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Pinned baseline; changing this requires reindexing the corpus.
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
CHUNK_TOKENS=400
CHUNK_OVERLAP=50
HF_HOME=../data/models
RAW_DATA_DIR=../data/raw
# Dedicated disposable database for integration tests; never use your real database.
# TEST_DATABASE_URL=postgresql+psycopg://thesis:CHANGE_ME@localhost:55432/thesis_test

# Server-only OpenAI credentials. Never use NEXT_PUBLIC_ for these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REVIEW_MODEL=gpt-4.1
LOGIN_USERNAME=thesis
# Legacy bootstrap hash for manage_users.py import-local; new users live in DB.
LOGIN_PASSWORD_HASH=
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# 0 restores content-only vector retrieval. Heading vectors are cached in memory.
RETRIEVAL_METADATA_WEIGHT=0.3
RETRIEVAL_CANDIDATES=50

# Google Identity Services Web client ID (public identifier, not a client secret).
# Authorized JavaScript origins: http://localhost:3000 and http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
